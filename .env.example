# Copy to .env and adjust. Every value here is a development/test value.
POSTGRES_PASSWORD=naebka
NAEBKA_JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# PLAY_MONEY only. REAL_MONEY refuses to start without a license sign-off file (risk #13).
NAEBKA_CURRENCY_MODE=PLAY_MONEY
# Admin account created on first start (used for the settlement manual-review queue).
NAEBKA_ADMIN_USERNAME=admin
NAEBKA_ADMIN_PASSWORD=admin12345
# Anti-collusion: block players with the same IP from one poker table.
# Off by default locally, because every browser on your machine shares 127.0.0.1.
NAEBKA_POKER_BLOCK_SAME_IP=false
DEADLOCK_API_BASE_URL=https://api.deadlock-api.com
# Steam bot fallback (`docker compose --profile bot up`), asked when deadlock-api says "too many requests".
DEADLOCK_BOT_URL=http://deadlock-bot:8090
# Optional shared secret between the bot and core/watcher. Set one if the bot runs on another machine.
DEADLOCK_BOT_TOKEN=
WATCHER_MAX_TRACKED=8
# Realtime map: admins and premium players may always watch; others need this many tokens staked on the match
# (0 = any logged-in player). Frames reach viewers this many seconds late, so markets are suspended first.
LIVE_VIEW_MIN_STAKE_TOKENS=100
LIVE_VIEW_DELAY_SECONDS=5
# Most broadcasts the bot follows at once (tracked matches first, then the ones viewers have open).
DEADLOCK_BOT_MAX_FEEDS=12
WATCHER_POLL_SECONDS=10
ODDS_MARGIN=0.06
# MetaMask + Sepolia deposits (contracts/NaebkaCashier.sol). Empty address = feature off.
# Sepolia only: test ETH has no value, so the app stays in PLAY_MONEY mode. Never point this at mainnet.
NAEBKA_ETH_CONTRACT_ADDRESS=
# Block number of the deployment transaction (Etherscan shows it); the poller starts there.
NAEBKA_ETH_DEPLOY_BLOCK=0
NAEBKA_ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# 0.001 Sepolia ETH = 100 NTK
NAEBKA_ETH_TOKENS_PER_ETH=100000
NAEBKA_ETH_CONFIRMATIONS=3
# The address players open in the browser. MetaMask warns if the sign-in message names another site.
NAEBKA_ETH_SIWE_DOMAIN=localhost:8080
NAEBKA_ETH_SIWE_URI=http://localhost:8080
# Withdrawals to MetaMask: private key (0x + 64 hex) of the contract's operator account (setOperator).
# A Sepolia TEST account that only pays gas. Empty = withdrawals off. Never use a key that holds real money.
NAEBKA_ETH_OPERATOR_KEY=
# A payout waits while gas costs more than this (gwei).
NAEBKA_ETH_MAX_FEE_GWEI=50

# Deadlock's music, built into the core image from frontend/public/music: fetch = also download anything missing from
# deadlock.wiki; skip = never contact the wiki. See "No music?" in the README.
NAEBKA_MUSIC=fetch

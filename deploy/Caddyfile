# The site. Caddy gets and renews the HTTPS certificate by itself as soon as the domain's DNS A record points here;
# until then it keeps retrying in the background (harmless).
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy core:8081
}

# Plain-HTTP access by the server's IP, for checking the deployment before DNS is set up.
# (MetaMask sign-in expects the domain, so use the domain for real play.)
http://{$SERVER_IP} {
	encode zstd gzip
	reverse_proxy core:8081
}

# The domain is proxied by Cloudflare (orange cloud, SSL mode Full/Full strict). Visitors reach Cloudflare, Cloudflare
# reaches this server on 443 (via the SNI router, deploy/haproxy.cfg, which prepends a PROXY protocol header) or 80.
{
	servers :443 {
		# The real visitor IP: trusted only from Cloudflare's ranges (https://www.cloudflare.com/ips), so a direct
		# visitor can't fake it with a header. Update the list if Cloudflare publishes new ranges.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow 0.0.0.0/0 ::/0
			}
			tls
		}
	}
}

# The site. Let's Encrypt certificate, obtained and renewed by Caddy (HTTP challenge, passed through by Cloudflare).
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy core:8081 {
		# One clean value for the core (Spring reads the left-most X-Forwarded-For): the visitor's IP from above.
		header_up X-Forwarded-For {client_ip}
	}
}

# The site is served only on the domain: visits by the server's IP are sent there.
http://{$SERVER_IP} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
